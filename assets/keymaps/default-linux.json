// Alacrterm 默认按键绑定（Linux / X11）
//
// 语法与 Zed 一致：数组，每项一节 `{ "context"?, "bindings": {..} }`；
// 键位用空格分隔即多键序列；"null" = 解绑；支持 `//`、`/* */` 注释与尾随逗号。
//
// ⚠️ 绑在 "Terminal" context 上的键**不会再进 PTY**（gpui 的按键派发是「动作优先」），
// 所以这里只放确实要拦下来的键；shell 在用的 ctrl-a/b/c/d/e/k/l/n/p/r/u/w/y 等一律不碰。
// 用户改动请写在 config/keymap.json（后加载者胜）。
[
  {
    // `!Dialog`：对话框开着时这些应用级键位让位（否则能嵌套弹出对话框）。
    "context": "!Dialog",
    "bindings": {
      "ctrl-shift-n": "alacrterm::NewLocalTerminal",
      "ctrl-shift-w": "alacrterm::CloseActiveSession",
      "ctrl-tab": "alacrterm::NextSession",
      "ctrl-shift-tab": "alacrterm::PrevSession",
      "alt-1": ["alacrterm::ActivateSession", 0],
      "alt-2": ["alacrterm::ActivateSession", 1],
      "alt-3": ["alacrterm::ActivateSession", 2],
      "alt-4": ["alacrterm::ActivateSession", 3],
      "alt-5": ["alacrterm::ActivateSession", 4],
      "alt-6": ["alacrterm::ActivateSession", 5],
      "alt-7": ["alacrterm::ActivateSession", 6],
      "alt-8": ["alacrterm::ActivateSession", 7],
      "alt-9": ["alacrterm::ActivateSession", 8],
      "ctrl-shift-d": "alacrterm::SplitSessionRight",
      "ctrl-shift-s": "alacrterm::SplitSessionDown",
      "ctrl-shift-left": "alacrterm::FocusPaneLeft",
      "ctrl-shift-right": "alacrterm::FocusPaneRight",
      "ctrl-shift-up": "alacrterm::FocusPaneUp",
      "ctrl-shift-down": "alacrterm::FocusPaneDown",
      "ctrl-shift-b": "alacrterm::ToggleSidebar",
      "ctrl-shift-e": "alacrterm::ShowSessionsView",
      "ctrl-shift-g": "alacrterm::ShowFilesView",
      "ctrl-shift-m": "alacrterm::NewSessionDialog",
      "ctrl-,": "alacrterm::OpenSettings",
      "ctrl-=": "alacrterm::IncreaseFontSize",
      "ctrl-shift-=": "alacrterm::IncreaseFontSize",
      "ctrl--": "alacrterm::DecreaseFontSize",
      "ctrl-0": "alacrterm::ResetFontSize"
      // 终端内查找（UI 未实现，先留占位）：
      // "ctrl-shift-f": "alacrterm::SearchTerminal"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      // 压掉 gpui-kit `Root` 的焦点切换，把 Tab 交回终端。
      "tab": "null",
      "shift-tab": "null",
      "ctrl-shift-c": "alacrterm::CopyText",
      "ctrl-shift-v": "alacrterm::PasteText",
      "ctrl-shift-k": "alacrterm::ClearTerminal",
      "shift-pageup": "alacrterm::ScrollPageUp",
      "shift-pagedown": "alacrterm::ScrollPageDown",
      "shift-home": "alacrterm::ScrollToTop",
      "shift-end": "alacrterm::ScrollToBottom",
      "shift-up": "alacrterm::ScrollLineUp",
      "shift-down": "alacrterm::ScrollLineDown",
      "ctrl-shift-space": "alacrterm::ToggleViMode"
    }
  },
  {
    // 预览窗口（`preview_window.rs`）：Ctrl+S 把改过的文本写回远端。
    "context": "Preview",
    "bindings": {
      "ctrl-s": "alacrterm::SavePreviewFile"
    }
  }
]
